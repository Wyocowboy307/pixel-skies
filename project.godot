; Engine configuration file.
; Pixel Skies — standalone from Pixel Ranch and Pocket Arcana.
config_version=5

[application]
config/name="Pixel Skies"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

DevCapture="*res://scripts/dev/dev_capture.gd"

[display]

; The game renders at a fixed 640x360 and is scaled to the window by whole
; numbers only, so pixels stay square at 1280x720 (2x) and 1920x1080 (3x).
; See docs/PIXEL_STYLE_GUIDE.md section 1.
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://assets/ui/pixel_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; 0 = nearest. Nothing in this game may be filtered.
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
